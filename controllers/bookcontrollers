const Book = require("../models/todo");

// ADD PAGE
exports.addPage = (req, res) => {
  res.render("pages/index");
};

// VIEW PAGE
exports.viewBooks = async (req, res) => {
  const books = await Book.find();
  res.render("pages/viewbook", { books });
};

// add book
exports.addBook = async (req, res) => {
  await Book.create({ title: req.body.title });
  res.redirect("/view");
};

// remove book
exports.deleteBook = async (req, res) => {
  await Book.findByIdAndDelete(req.params.id);
  res.redirect("/view");
};

// EDIT PAGE
exports.editBookPage = async (req, res) => {
  const book = await Book.findById(req.params.id);
  res.render("pages/editbook", { book });
};

// UPDATE BOOK
exports.updateBook = async (req, res) => {
  await Book.findByIdAndUpdate(req.params.id, { title: req.body.title });
  res.redirect("/view");
};



